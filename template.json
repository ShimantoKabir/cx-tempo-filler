    "recipe": [
      {
        "image": {
          "english": "https://i5.walmartimages.ca/dfw/8822aef6-5b35/k2-_50ab4c97-c04f-4e98-9eb0-f9e5edd129c1.v1.jpg",
          "french": "https://i5.walmartimages.ca/dfw/8822aef6-d9ac/k2-_7aafc05c-2562-4f31-b865-e7c8cd172c03.v1.jpg"
        },
        "alt": {
          "english": "Crescent mummy dogs",
          "french": "Hot-dogs momies"
        },
        "title": {
          "english": "Crescent mummy dogs",
          "french": "Hot-dogs momies"
        },
        "subhead": {
          "english": "Adorable, crescent-wrapped hot dogs, perfect for the spooky season.",
          "french": "Saucisses enroulées dans de la pâte à croissant pour l'Halloween."
        },
        "prepTime": {
          "english": "30 minutes",
          "french": "30 minutes"
        },
        "cookTime": {
          "english": "50 minutes",
          "french": "50 minutes"
        },
        "servingSize": {
          "english": "10",
          "french": "10"
        },
        "ingredientsLabel": {
          "english": "Ingredients you'll need",
          "french": "Ingrédients requis"
        },
        "ingredients": {
          "english": [
            "1 can (8 oz) refrigerated Pillsbury Crescent Rolls (8 count) or 1 can (8 oz) refrigerated Pillsbury Weiner Wraps",
            "2 1/2 slices of hard cheese",
            "1 package (10 count) of your favourite hot dogs",
            "Cooking spray",
            "Mustard or ketchup, if desired"
          ],
          "french": [
            "1 emballage (8 oz) de pâte pour croissants Pillsbury réfrigérée (8 unités) ou 1 emballage (8 oz) de pâte pour saucisses Pillsbury réfrigérée",
            "2 1/2 tranches de fromage",
            "1 paquet (10 unités) de vos saucisses préférées",
            "Enduit à cuisson",
            "Moutarde ou ketchup, si désiré"
          ]
        },
        "directionsLabel": {
          "english": "Directions",
          "french": "Préparation"
        },
        "directions": {
          "english": [
            "Heat oven to 350°F.",
            "If using crescent rolls: unroll dough and separate at perforations, creating 4 rectangles. Press perforations to seal. If using a dough sheet: unroll dough and cut into 4 rectangles.",
            "Cut each rectangle lengthwise with a knife or pizza cutter into strips under ½ inch wide (about 10 pieces per rectangle), for a total of 40 pieces.",
            "Slice cheese slices into quarters (½ slice cheese, cut in half).",
            "Wrap 4 pieces of dough around each hot dog and ¼ slice of cheese to look like \"bandages,\" stretching dough slightly to cover hot dog completely.",
            "About ½ inch from one end of each hot dog, separate \"bandages\" so the hot dog shows through for \"face.\"",
            "On an ungreased large cookie sheet, place wrapped hot dogs (cheese side down) and spray dough lightly with cooking spray.",
            "Bake 13-17 minutes or until dough is light golden brown and hot dogs are hot.",
            "Using a toothpick, dip one end into mustard and draw features on the \"face.\""
          ],
          "french": [
            "Préchauffer le four à 350 °F.",
            "Avec une pâte pour croissants : dérouler la pâte et séparer aux perforations de façon à créer 4 rectangles. Appuyer sur les perforations pour sceller. Avec une feuille de pâte : dérouler la pâte et la couper en 4 rectangles.",
            "Avec un couteau ou un coupe-pizza, couper chaque rectangle dans le sens de la longueur en une dizaine de bandelettes de moins de 1,3 cm (½ po) de large, pour obtenir un total de 40 bandelettes.",
            "Couper les tranches de fromage en 4 morceaux (couper chaque demi-tranche en deux autres moitiés).",
            "Enrouler 4 bandelettes de pâte autour de chaque saucisse et d'un morceau de fromage en leur donnant l'apparence de bandages. Étirer légèrement la pâte pour couvrir complètement la saucisse.",
            "À environ 1,3 cm (½ po) d'une extrémité de la saucisse, séparer les « bandages » pour montrer le « visage » de la momie.",
            "Sur une grande plaque à biscuits non graissée, déposer les saucisses enrobées de pâte (le côté avec le fromage en dessous) et vaporiser légèrement la pâte d'enduit à cuisson.",
            "Cuire de 13 à 17 minutes ou jusqu'à ce que la pâte soit légèrement dorée et que les saucisses soient chaudes.",
            "Tremper l'extrémité d'un cure-dent dans la moutarde et dessiner des traits sur le « visage »."
          ]
        }
      }
    ],
